DATA_DIR=./data
LEDGER_ROOT=./data/ledgers
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
INVITE_CODE=replace-with-a-private-invite
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-5.6-terra
EMBEDDING_ENABLED=false
# 必须是兼容 OpenAI 的 embeddings 端点，代码会在其后拼 /embeddings。
# 阿里云百炼填兼容模式地址（如 https://dashscope.aliyuncs.com/compatible-mode/v1），
# 不要填 /api/v1/services/embeddings/... 那个原生端点，请求体格式不一样。
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=text-embedding-3-small
# 单次请求的最大条数，服务商各有上限（如百炼 text-embedding-v4 是 20）。
EMBEDDING_BATCH_SIZE=32
CONFIDENCE_THRESHOLD=0.8
CLARIFICATION_CANDIDATE_LIMIT=12
# 对话重命名上限与新对话自动标题的截取字数。
CONVERSATION_TITLE_MAX_LENGTH=40
CONVERSATION_TITLE_AUTO_LENGTH=10

# diff 上文行数与右栏写入历史条数。
LEDGER_CONTEXT_LINES=5
LEDGER_HISTORY_LIMIT=10
